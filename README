<div class="box">
<h2>آزمایشگاه پرداخت</h2>
<p>این برنامه به بانک وصل نیست.</p>
<p>موجودی فرضی کارت: ۲۰ همت</p>

<label>مبلغ آزمایشی به تومان</label><br><br>
<input id="amount" type="number" value="500000">

<button onclick="ok()">ثبت آزمایشی</button>
<button onclick="show()">نمایش پیام موفقیت</button>
<button onclick="bad()">پرداخت ناموفق</button>

<h3>موجودی فرضی فروشنده</h3>
<h2 id="balance">۰ تومان</h2>
<div id="result">آماده آزمایش</div>
</div>

<script>
let balance=0;

function ok(){
 let a=Number(document.getElementById("amount").value);
 if(a<=0){document.getElementById("result").innerText="مبلغ را بررسی کن";return;}
 balance+=a;
 document.getElementById("balance").innerText=balance.toLocaleString("fa-IR")+" تومان";
 document.getElementById("result").innerText="ثبت آزمایشی انجام شد.";
}
function show(){
 document.getElementById("result").innerText="پیام موفقیت نمایشی؛ موجودی تغییر نکرد.";
}
function bad(){
 document.getElementById("result").innerText="پرداخت ناموفق؛ موجودی تغییر نکرد.";
}
</script>
</body>
</html>
